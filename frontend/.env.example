# Base URL of the FastAPI backend. Only used if VITE_USE_MOCK_API=false.
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" (default) to use the built-in mock REST layer, which
# implements the same Project/Issue contract as the FastAPI backend.
# Set to "false" to call the real backend directly.
VITE_USE_MOCK_API=true
